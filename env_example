# Провайдер мультимодальной модели: deepseek либо yandex
VLM_PROVIDER=deepseek
VLM_MAX_TOKENS=6000

# DeepSeek — основная модель
DEEPSEEK_API_KEY=<ключ-api-deepseek>
DEEPSEEK_BASE_URL=https://api.deepseek.com
