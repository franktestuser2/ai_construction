# Yandex Cloud AI Studio — запасная модель, нужна при VLM_PROVIDER=yandex
YC_API_KEY=<api-ключ-сервисного-аккаунта>
YC_FOLDER_ID=<идентификатор-каталога>
YC_VLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
YC_VLM_MODEL=qwen3.6-35b-a3b

# Пороги распознавания и правил
DETECTOR_CONFIDENCE_THRESHOLD=0.05
IDLE_STREAK_DAYS=3

# Фасадные модели: пороги из рабочей конфигурации авторов
